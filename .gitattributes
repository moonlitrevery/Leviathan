# O desenvolvimento é no Windows (core.autocrlf=true) e o deploy é Linux. Sem
# isto, os arquivos abaixo iriam para a VM com CRLF e quebrariam: o shell
# reclama de "\r" no shebang do script, e o systemd não entende a unit.
*.sh            text eol=lf
*.service       text eol=lf
*.cron          text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
docker-compose.yml text eol=lf

# Código e dados: LF no repositório, o checkout local decide o resto.
*.py     text
*.toml   text
*.json   text
*.md     text
*.yml    text
*.yaml   text
*.xml    text
*.txt    text

# Binários não podem ser tocados por normalização de fim de linha.
*.ttf    binary
*.png    binary
*.db     binary
