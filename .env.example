# Copie para .env e preencha. O arquivo .env nunca entra no git.

# Token do bot: https://discord.com/developers/applications > seu app > Bot > Reset Token
DISCORD_TOKEN=

# ID do servidor onde os slash commands sao sincronizados (Modo Desenvolvedor
# ligado > botao direito no servidor > Copiar ID do servidor).
# Para varios servidores, separe os IDs por virgula - com ou sem espaco:
#   GUILD_ID=123456789012345678
#   GUILD_ID=123456789012345678, 987654321098765432
# O bot precisa estar em cada servidor listado, convidado com o escopo
# applications.commands. Um servidor que falhar vira aviso no log e nao impede
# os outros de sincronizar.
GUILD_ID=

# Caminho do banco SQLite. Relativo a raiz do projeto. Opcional.
DATABASE_PATH=data/leviathan.db

# OPCIONAL. Chave da API da Last.fm, para os comandos /fm.
# Crie em https://www.last.fm/api/account/create
# Sem ela, o cog lastfm nao carrega e o resto do bot sobe normalmente.
LASTFM_API_KEY=
