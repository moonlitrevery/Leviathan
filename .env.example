# Copie para .env e preencha. O arquivo .env nunca entra no git.

# Token do bot: https://discord.com/developers/applications > seu app > Bot > Reset Token
DISCORD_TOKEN=

# ID do servidor de desenvolvimento (Modo Desenvolvedor ligado > botao direito no
# servidor > Copiar ID do servidor). Os slash commands sao sincronizados nele.
GUILD_ID=

# Caminho do banco SQLite. Relativo a raiz do projeto. Opcional.
DATABASE_PATH=data/leviathan.db
